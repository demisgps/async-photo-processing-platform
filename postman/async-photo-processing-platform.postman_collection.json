{
  "info": {
    "name": "Async Photo Processing Platform - Fase 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Happy path",
      "item": [
        {
          "name": "Cadastrar usuário com foto",
          "request": {
            "method": "POST",
            "body": {"mode": "formdata", "formdata": [
              {"key": "nome", "value": "Usuário Postman", "type": "text"},
              {"key": "foto", "type": "file", "src": ""}
            ]},
            "url": "{{baseUrl}}/api/v1/usuarios"
          },
          "event": [{"listen": "test", "script": {"exec": [
            "pm.response.to.have.status(201);",
            "const body = pm.response.json();",
            "pm.environment.set('usuarioId', body.id); // usuarioId = response.id",
            "pm.environment.set('processamentoId', body.processamentoId);",
            "pm.expect(body.status).to.eql('PROCESSANDO');"
          ]}}]
        },
        {"name": "Consultar processamento", "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/processamentos/{{processamentoId}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.response.to.have.status(200);"]}}]},
        {"name": "Consultar usuário", "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/usuarios/{{usuarioId}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.response.to.have.status(200);"]}}]},
        {"name": "Listar usuários", "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/usuarios"}, "event": [{"listen": "test", "script": {"exec": ["pm.response.to.have.status(200);"]}}]},
        {"name": "Atualizar nome", "request": {"method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"nome\":\"Nome Atualizado\"}"}, "url": "{{baseUrl}}/api/v1/usuarios/{{usuarioId}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.response.to.have.status(200);"]}}]},
        {"name": "Consultar foto atual", "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/usuarios/{{usuarioId}}/foto"}, "event": [{"listen": "test", "script": {"exec": ["pm.response.to.have.status(200);", "pm.expect(['image/jpeg','image/png']).to.include(pm.response.headers.get('Content-Type'));", "pm.expect(pm.response.stream.length).to.be.above(0);"]}}]},
        {"name": "Upload posterior", "request": {"method": "POST", "body": {"mode": "formdata", "formdata": [{"key": "foto", "type": "file", "src": ""}]}, "url": "{{baseUrl}}/api/v1/usuarios/{{usuarioId}}/fotos"}, "event": [{"listen": "test", "script": {"exec": ["pm.response.to.have.status(202);", "pm.environment.set('processamentoId', pm.response.json().processamentoId);"]}}]},
        {"name": "Excluir usuário", "request": {"method": "DELETE", "url": "{{baseUrl}}/api/v1/usuarios/{{usuarioId}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.response.to.have.status(204);"]}}]}
      ]
    },
    {
      "name": "Matriz negativa",
      "item": [
        {"name": "Usuário inexistente - 404", "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/usuarios/9223372036854775807"}, "event": [{"listen": "test", "script": {"exec": ["pm.response.to.have.status(404);"]}}]},
        {"name": "Nome inválido - 400", "request": {"method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"nome\":\" \"}"}, "url": "{{baseUrl}}/api/v1/usuarios/{{usuarioId}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.response.to.have.status(400);"]}}]},
        {"name": "Foto ausente - 400", "request": {"method": "POST", "body": {"mode": "formdata", "formdata": [{"key": "nome", "value": "Sem Foto", "type": "text"}]}, "url": "{{baseUrl}}/api/v1/usuarios"}, "event": [{"listen": "test", "script": {"exec": ["pm.response.to.have.status(400);"]}}]}
      ]
    }
  ]
}
